# Copy to .env and fill in real values. Never commit .env.

# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER:5432/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Phase 2+ (Telegram bot and AI). Not required for the database phase.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=600

PORT=3000
