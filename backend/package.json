{
  "name": "parent-communication-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Parent Communication Agent demo (Fastify + Prisma + PostgreSQL).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "ai:eval": "tsx tests/ai-eval/run.ts",
    "ai:eval:real": "tsx tests/ai-eval/run.ts --real",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:summary": "tsx prisma/summary.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@neon/config": "^1.14.7",
    "@neon/env": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "fastify": "5.12.8",
    "grammy": "^1.48.0",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
